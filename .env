DRIFT_MODE=live
APP_HOST=127.0.0.1
APP_PORT=8765

# Live mode settings
TERRAFORM_WORKDIR=C:\path\to\terraform\environment
TERRAFORM_WORKSPACE=
AZURE_SUBSCRIPTION_ID=41be3ed6-bd03-433a-94a1-6b5c54f1b501
AZ_CLI_PATH=
TERRAFORM_CLI_PATH=

# State source. Use "terraform" to run terraform plan from TERRAFORM_WORKDIR,
# or "azure-state" to load managed resources from a .tfstate blob.
DRIFT_SOURCE=azure-state
STATE_STORAGE_ACCOUNT=sabluelinux
STATE_CONTAINER=tfstate
STATE_BLOB=terraform.tfstate

# Optional: limit activity lookback.
AZURE_ACTIVITY_DAYS=14
